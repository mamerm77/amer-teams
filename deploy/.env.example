DOMAIN=teams.example.com
SERVER_NAME=example.com
POSTGRES_PASSWORD=change-me
LIVEKIT_API_KEY=APIamerteams
LIVEKIT_API_SECRET=generate-with-openssl-rand-hex-32
# AI engine — Anthropic API key (or point LLM_BASE_URL at a self-hosted model)
ANTHROPIC_API_KEY=sk-ant-...
LLM_MODEL=claude-sonnet-4-5
# Guardian: comma-separated labels that agents may never export
# filled in by create-admin.sh
SYNAPSE_ADMIN_TOKEN=
GUARDIAN_BLOCK_LABELS=Confidential,Restricted
